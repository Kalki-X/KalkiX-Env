# ===========================
# 🌍 GLOBAL ENVIRONMENT FILE
# ===========================

# Turn on only the profiles you want (comma-separated).
# GearShare's default stack: Node API + React app + Postgres (+ pgAdmin).
COMPOSE_PROFILES=node,react,postgres,postgres-tools
# Optional extras, add to the list above if you need them:
#   php,mysql,mysql-tools   -> legacy PHP/MySQL sandbox (unused by GearShare)
#   mongo,mongo-tools       -> MongoDB + Mongo Express (unused by GearShare)

# ---------- Ports ----------
NODE_PORT=3000
REACT_PORT=5173
PHP_PORT=8080
PHPMYADMIN_PORT=8081
MONGO_EXPRESS_PORT=8082
ADMINER_PORT=8083
PGADMIN_PORT=8084

# ---------- Postgres (primary datastore) ----------
POSTGRES_DB=gearshare
POSTGRES_USER=gearshare
POSTGRES_PASSWORD=changeme
POSTGRES_URL=postgresql://gearshare:changeme@postgres:5432/gearshare

PGADMIN_DEFAULT_EMAIL=admin@gearshare.local
PGADMIN_DEFAULT_PASSWORD=changeme

# ---------- MySQL (legacy, unused by GearShare) ----------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# ---------- Mongo (legacy, unused by GearShare) ----------
MONGO_INITDB_DATABASE=testdb
MONGO_URL=mongodb://mongo:27017/testdb

# ---------- Node API ----------
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string
# Session length when "Remember me" is NOT checked (also a browser-session cookie,
# cleared on browser close) vs. when it IS checked (persisted cookie + longer-lived token).
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d
COOKIE_SECURE=false
REACT_URL=http://localhost:5173

# One-time bootstrap for the very first Super Admin account (no self-registration
# path exists for this role on purpose). Set these, start the stack once, then you
# can leave them or blank them out again — bootstrap is a no-op once a super_admin exists.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ---------- Outgoing email (forgot-password links, future notifications) ----------
# Leave SMTP_HOST blank for local dev — emails are logged to the node_server console
# instead of actually being sent. Works with any SMTP provider (Gmail app password,
# SendGrid, Mailgun, AWS SES, Postmark, ...) — just point these at it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=GearShare <no-reply@gearshare.local>

# ---------- Google Sign-In ----------
# From Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID
# (Web application). Add GOOGLE_CALLBACK_URL below as an Authorized redirect URI.
# Leave GOOGLE_CLIENT_ID blank to keep the feature disabled (buttons show a clear
# "not configured" message instead of a dead click).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---------- React App ----------
VITE_API_URL=http://localhost:3000
